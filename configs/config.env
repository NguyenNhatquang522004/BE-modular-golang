# database postgres config
Host= "localhost"
PORT = "5432"
POSTGRES_USER = "user"
POSTGRES_PASSWORD = "123"
POSTGRES_DB = "be_modular_golang"
DB_SSLMODE = "disable"
DB_TIMEZONE = "Asia/Shanghai"

# --- REDIS ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# --- MONGODB ---
# Format: mongodb://[username:password@]host[:port]
MONGO_URI=mongodb://admin:123@localhost:27017
MONGO_DB_NAME=be_modular_golang
# --- ELASTICSEARCH ---
ES_ADDRESS=http://localhost:9200
# Do bạn set xpack.security.enabled=false nên không cần user/pass
# --- NEO4J ---
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=123456789
# --- CASSANDRA ---
CASSANDRA_HOST=localhost
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=be_modular_keyspace
# --- SEAWEEDFS ---
SEAWEEDFS_FILER_URL=http://localhost:8888
SEAWEEDFS_S3_URL=http://localhost:8333
S3_REGION=us-east-1
S3_ACCESS_KEY=any           
S3_SECRET_KEY=any
S3_BUCKET_NAME=my-app-assets

# --- APPLICATION SETTINGS ---
#google 
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URL=http://localhost:8085/api/v1/auth/google/callback
#jwt
JWT_SECRET_KEY="your_jwt_secret_key"
JWT_EXPIRES_IN_HOURS=72
# Email SMTP config
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your-email@gmail.com
SMTP_PASSWORD=abcd efgh ijkl mnop  # Mật khẩu ứng dụng vừa tạo
SMTP_SENDER_NAME="My App Support"
# server config
SERVER_PORT = "8086"
Base_URL = "/api/v1"