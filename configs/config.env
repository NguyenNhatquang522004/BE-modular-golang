# ==============================================================================
# 1. PROJECT & DOCKER CONFIGURATION (Dùng cho Docker Compose)
# ==============================================================================
PROJECT_NAME=BE-modular-golang
NETWORK_NAME=be_modular_golang_network

# ==============================================================================
# 2. APPLICATION SERVER (Cấu hình cho Go App)
# ==============================================================================
SERVER_HOST=localhost
SERVER_PORT=8086
BASE_URL=/api/v1
# Chế độ chạy: debug / release
GIN_MODE=debug
# Timezone cho App và DB
TIMEZONE=Asia/Shanghai

# ==============================================================================
# 3. DATABASE: POSTGRESQL
# ==============================================================================
# Cấu hình Docker
POSTGRES_VERSION=15
POSTGRES_PORT=5432
# Cấu hình App & Docker dùng chung
POSTGRES_HOST=localhost
POSTGRES_USER=user
POSTGRES_PASSWORD=123
POSTGRES_DB=be_modular_golang
DB_SSLMODE=disable

# PgAdmin (Quản lý DB)
PGADMIN_EMAIL=user@example.com
PGADMIN_PASSWORD=adminpassword
PGADMIN_PORT=5050

# ==============================================================================
# 4. DATABASE: REDIS
# ==============================================================================
# Cấu hình Docker
REDIS_VERSION=7.2-bookworm
REDIS_COMMANDER_PORT=8081
# Cấu hình App
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

##
REDIS_LOCK_TTL=5
REDIS_LOCK_COMPLETED_TTL=24
# ==============================================================================
# 5. DATABASE: MONGODB
# ==============================================================================
# Cấu hình Docker
MONGO_VERSION=6.0
MONGO_EXPRESS_VERSION=1.0.2
MONGO_EXPRESS_PORT=8082
MONGO_EXPRESS_USER=developer
MONGO_EXPRESS_PASSWORD=devpassword
# Cấu hình App
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=123
MONGO_DB_NAME=be_modular_golang
# Connection String (Lưu ý: user/pass phải khớp với biến ROOT ở trên)
MONGO_URI=mongodb://admin:123@localhost:27017

# ==============================================================================
# 6. DATABASE: ELASTICSEARCH & KIBANA
# ==============================================================================
ELASTIC_VERSION=8.10.2
ELASTIC_PORT=9200
KIBANA_PORT=5601
# App Config
ES_ADDRESS=http://localhost:9200
# User/Pass trống do xpack.security.enabled=false

# ==============================================================================
# 7. DATABASE: NEO4J
# ==============================================================================
NEO4J_VERSION=5.11
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
# App Config
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=123456789

# ==============================================================================
# 8. DATABASE: CASSANDRA
# ==============================================================================
CASSANDRA_VERSION=4.1.3
CASSANDRA_PORT=9042
CASSANDRA_CLUSTER_NAME=MyCluster
CASSANDRA_DC=datacenter1
CASSANDRA_RACK=rack1
# App Config
CASSANDRA_HOST=localhost
CASSANDRA_KEYSPACE=be_modular_keyspace

# ==============================================================================
# 9. STORAGE: SEAWEEDFS (S3)
# ==============================================================================
SEAWEEDFS_IMAGE=chrislusf/seaweedfs:latest
# Ports mapping
SEAWEEDFS_MASTER_PORT=9333
SEAWEEDFS_MASTER_GRPC=19333
SEAWEEDFS_VOLUME_PORT=8083
SEAWEEDFS_VOLUME_GRPC=18080
SEAWEEDFS_FILER_PORT=8888
SEAWEEDFS_FILER_GRPC=18888
SEAWEEDFS_S3_PORT=8333
# App Config (URL truy cập từ máy host)
SEAWEEDFS_FILER_URL=http://localhost:8888
SEAWEEDFS_S3_URL=http://localhost:8333
S3_REGION=us-east-1
S3_ACCESS_KEY=any
S3_SECRET_KEY=any
S3_BUCKET_NAME=my-app-assets

# ==============================================================================
# 10. AUTH: KEYCLOAK
# ==============================================================================
KEYCLOAK_VERSION=22.0.1
KEYCLOAK_PORT=8085
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_REDIRECT_URI=http://localhost:8086/api/v1/auth/keycloak/callback
# Tên Database Keycloak dùng trong Postgres
KC_DB_NAME=keycloak
# App Config
# Lưu ý: Port 8085 vì Docker map 8085:8080
KEYCLOAK_SERVER_URL=http://localhost:8085
KEYCLOAK_REALM=myrealm
KEYCLOAK_CLIENT_ID=myclient
KEYCLOAK_CLIENT_SECRET=myclientsecret
KEYCLOAK_AuthURL=http://localhost:8085/realms/myrealm/protocol/openid-connect/auth
KEYCLOAK_TokenURL=http://localhost:8085/realms/myrealm/protocol/openid-connect/token
KEYCLOAK_UserInfoURL=http://localhost:8085/realms/myrealm/protocol/openid-connect/userinfo

# ==============================================================================
# 11. MESSAGE QUEUE: KAFKA (KRaft Mode)
# ==============================================================================
KAFKA_VERSION=7.6.0
KAFKA_UI_IMAGE=provectuslabs/kafka-ui:latest
KAFKA_PORT=9092
KAFKA_UI_PORT=8080
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk

# App Config
# Nếu chạy code Go ở máy thật (Localhost) -> Dùng localhost:9092
# Nếu chạy code Go trong Docker container -> Dùng kafka_BE-modular-golang:29092
KAFKA_BROKERS=localhost:9092
KAFKA_GROUP_ID=social-network-monolith
KAFKA_TOPIC_USER_REGISTERED=user.registered
KAFKA_TOPIC_POST_CREATED=post.created
## DLQ Topic (Dead Letter Queue) để lưu các message lỗi sau khi retry hết
KAFKA_TOPIC_DLQ=dlq.events
KAFKA_MAX_RETRIES=3
KAFKA_RETRY_BACKOFF_MS=2000
# ==============================================================================
# 12. SECURITY & MAIL SECRETS
# ==============================================================================
# Google Auth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Redirect URL phải khớp với port SERVER_PORT (8086) chứ không phải Keycloak (8085)
GOOGLE_REDIRECT_URL=http://localhost:8086/api/v1/auth/google/callback

# JWT
JWT_SECRET_KEY=your_jwt_secret_key
JWT_EXPIRES_IN_HOURS=72

# Email SMTP (Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your-email@gmail.com
# Mật khẩu ứng dụng (App Password), không phải pass đăng nhập Gmail
SMTP_PASSWORD=abcdefghijklmnop
SMTP_SENDER_NAME="My App Support"

# ==============================================================================
# 13. GRPC SERVER CONFIGURATION
# ==============================================================================
GRPC_SERVER_HOST=localhost
GRPC_SERVER_PORT=50051

# ==============================================================================
# 14 .CircuitBreaker CONFIGURATION
# ==============================================================================
CIRCUIT_BREAKER_NAME=MyCircuitBreaker
CIRCUIT_BREAKER_MAX_REQUESTS=3
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_TIMEOUT_SECONDS=60
CIRCUIT_BREAKER_EXPECTED_RESPONSE_TIME_MS=2000
CIRCUIT_BREAKER_INTERVAL_MS=60000


## ==============================================================================
# 15. worker pool configuration
# ==============================================================================
WORKER_POOL_SIZE_MAX=10
WORKER_POOL_POST_INSIGHTS_MAX=100

# ==============================================================================
# 16. PAYMENT GATEWAY: VNPAY
# ==============================================================================
# Bật sandbox mode (true = sandbox / false = production)
VNPAY_IS_SANDBOX=true

# Terminal Code và Hash Secret do VNPay cấp sau khi đăng ký merchant
# Giá trị mặc định bên dưới là thông tin sandbox demo của VNPay
VNPAY_TMN_CODE=DEMOV210
VNPAY_HASH_SECRET=RAOEXHYVSDDIIENYWSLDIIZTANXUXZJP

# URL trang thanh toán VNPay
# - Sandbox:    https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# - Production: https://pay.vnpay.vn/vpcpay.html
# Để trống để tự động chọn theo VNPAY_IS_SANDBOX
VNPAY_PAYMENT_URL=

# URL Merchant API (query / refund)
# - Sandbox:    https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
# - Production: https://pay.vnpay.vn/merchant_webapi/api/transaction
# Để trống để tự động chọn theo VNPAY_IS_SANDBOX
VNPAY_API_URL=

# URL trong ứng dụng của bạn mà VNPay redirect người dùng về sau khi thanh toán
VNPAY_RETURN_URL=http://localhost:8086/api/v1/payment/vnpay/return

# URL nhận IPN (server-to-server) từ VNPay.
# Phải là URL công khai, có thể dùng ngrok/cloudflare tunnel khi dev.
# Để trống thì hệ thống tự dùng VNPAY_RETURN_URL làm fallback.
VNPAY_IPN_URL=


# live stream
LIVE_STREAM_SECRET_KEY=123

# ==============================================================================
# 17. AI ANALYSIS CONFIGURATION
# ==============================================================================
OLLAMA_API_URL=http://localhost:11434/api/generate
OLLAMA_MODEL_NAME=qwen2-vl:2b